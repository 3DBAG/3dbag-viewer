{
	"root": true,
	"parserOptions": {
        "ecmaVersion": 2018
	},

	"extends": [
		"mdcs",
		"plugin:vue/recommended"
	],
	"plugins": [ "jest" ],

	"rules": {
		"vue/multi-word-component-names": "off",
		"no-unused-vars": [ 1, { "args": "none" } ]
	},

	"overrides": [
		{
			"files": [ "babel.config.js" ],
			"rules": {
				"array-bracket-spacing": "off"
			}
		},
		{
			"files": [ "tests/**/*.js" ],
			"env": {
				"jest": true
			},
			"rules": {
				"padded-blocks": "off"
			}
		}
	]
}
