{
  "name": "3dbag-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test:unit": "jest --runInBand",
    "docs": "npx vuedoc.md src/components/*.vue --output docs/"
  },
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=26.0.0 <27.0.0"
  },
  "dependencies": {
    "@geo-frontend/nlmaps-maplibre": "1.0.1",
    "@mdi/font": "^5.7.55",
    "@vuedoc/md": "^3.0.0",
    "@vuedoc/parser": "^3.0.0",
    "3d-tiles-renderer": "0.5.2",
    "buefy": "^0.9.3",
    "core-js": "^3.6.5",
    "debounce": "^1.2.0",
    "flatgeobuf": "3.19.0",
    "jest": "^26.4.2",
    "lodash": "^4.17.20",
    "maplibre-gl": "5.24.0",
    "node-ipc": "^11.0.2",
    "ol": "^6.5.0",
    "proj4": "^2.7.2",
    "sass": "^1.27.0",
    "sass-loader": "^17.0.0",
    "three": "0.185.1",
    "tweakpane": "^1.6.1",
    "vue": "^2.6.11",
    "vue-i18n": "^8.22.2",
    "vue-inline-svg": "^2.0.0",
    "vue-json-pretty": "^1.9.4",
    "vue-router": "^3.4.5",
    "vuese": "^1.1.1",
    "x2js": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.7.2",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.7.1",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "babel-jest": "^25.4.0",
    "eslint": "^8.57.1",
    "eslint-config-mdcs": "^4.2.3",
    "eslint-plugin-jest": "^23.8.2",
    "eslint-plugin-vue": "^9.33.0",
    "jest": "^26.4.2",
    "jest-cli": "^25.4.0",
    "vue-template-compiler": "^2.6.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "no-unused-vars": [
        1,
        {
          "args": "none"
        }
      ]
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
